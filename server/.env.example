SECRET_KEY=change-me-to-something-random
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

DB_NAME=ehr_translator
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Leave as the console backend for local dev — sign-in links print to the
# runserver terminal instead of actually sending email. To test real Mailgun
# delivery locally instead, switch EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill in the EMAIL_HOST*
# values below from Mailgun's dashboard (Sending -> Domain settings -> SMTP
# credentials).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ehr-translator.local

# Where to send a heads-up when someone not on the invite list tries to sign
# in (accounts/views.py) — leave blank to skip notifying anyone (those
# attempts still show up in Django admin under Access requests either way).
OWNER_EMAIL=

# Get a free key at aistudio.google.com/apikey. Free-tier inputs/outputs may
# be used by Google to improve their products — extracted text is
# de-identified before it's sent, but this is a real trade-off, not just a
# formality (see the plan doc).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional — raises the NCBI PubMed E-utilities rate limit. Not required.
PUBMED_API_KEY=

# GCP project ID for the Cloud DLP redaction pass (see documents/dlp.py).
# Leave blank for local dev — that pass is skipped with a warning. Must be
# set before processing real patient data; requires `gcloud auth
# application-default login` (or a service account) with the roles/dlp.user
# role locally, and the Cloud Run service account to hold that role in
# production.
DLP_PROJECT_ID=

# GCP project ID for Cloud Vision OCR on image uploads (JPG/PNG/HEIC — see
# documents/vision.py). Leave blank for local dev to work on PDF uploads
# without GCP credentials; unlike DLP_PROJECT_ID above this isn't optional
# once you actually want to test an image upload, since OCR is the only way
# to get text out of one at all. Requires `gcloud auth application-default
# login` locally, or the Cloud Run service account, to be able to call the
# Vision API in this project — no dedicated IAM role needed for direct
# in-request image content (only gcs-referenced images need
# roles/storage.objectViewer, which doesn't apply here).
VISION_PROJECT_ID=

# GCP project ID for Cloud Translation (see documents/translate.py), used to
# derive every non-English Annotation from the canonical English one instead
# of a second independent Gemini generation per language. Leave blank for
# local dev to work in English without GCP credentials; a non-English
# language will fail clearly on request until this is set. Requires
# `gcloud auth application-default login` locally, or the Cloud Run service
# account, to hold roles/cloudtranslate.user in this project.
TRANSLATE_PROJECT_ID=

# GCS bucket for uploaded documents (Document.file). Leave blank for local
# dev — uploads fall back to server/media/ on local disk. Must be set in any
# deployed environment (the bucket should be private, CMEK-encrypted, and the
# runtime service account needs roles/storage.objectAdmin scoped to it).
GS_BUCKET_NAME=
GS_PROJECT_ID=

# GCP project for Vertex AI (see documents/gemini.py). Leave blank for local
# dev — falls back to the plain GEMINI_API_KEY client above. Must be set in
# any deployed environment: Vertex AI is the BAA-eligible path.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# Only needed if the Vertex-side model ID differs from GEMINI_MODEL.
VERTEX_MODEL=
