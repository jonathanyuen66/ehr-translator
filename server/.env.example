SECRET_KEY=change-me-to-something-random
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

DB_NAME=ehr_translator
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Leave as the console backend for local dev — sign-in links print to the
# runserver terminal instead of actually sending email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@ehr-translator.local

# Get a free key at aistudio.google.com/apikey. Free-tier inputs/outputs may
# be used by Google to improve their products — extracted text is
# de-identified before it's sent, but this is a real trade-off, not just a
# formality (see the plan doc).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional — raises the NCBI PubMed E-utilities rate limit. Not required.
PUBMED_API_KEY=
